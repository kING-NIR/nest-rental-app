# Production Environment Variables
# Copy to .env and update with your production values

# Backend (.env)
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nest-rental?retryWrites=true&w=majority
JWT_SECRET=generate-a-strong-random-secret-key-here-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://yourdomain.com

# Frontend (.env)
REACT_APP_API_URL=https://api.yourdomain.com/api
